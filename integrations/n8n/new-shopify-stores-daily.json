              "id": "7ba41e8d-2a66-5ea7-9231-27607a5602b8",
              "name": "products",
              "value": "={{ $json.products }}",
              "type": "number"
            },
            {
              "id": "714d2881-5e28-5a9a-9fa1-41798880659e",
