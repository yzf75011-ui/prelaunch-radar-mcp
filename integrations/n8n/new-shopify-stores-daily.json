        "url": "={{ $('Set your settings').first().json.webhookUrl }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "id": "f3012bf1-4df1-5689-b263-3c84776ce44e",
      "name": "Send each store to your webhook",
